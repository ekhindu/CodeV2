---
import settings from '../data/settings.json';
const { name = 'bottom', tall = false } = Astro.props;
const pub = settings.adsensePublisher; const slot = (settings.slots as any)[name];
---
<section class={`ad${tall ? ' tall' : ''}`} aria-label="Advertisement">
  {pub && slot ? <ins class="adsbygoogle" style="display:block;width:100%" data-ad-client={pub} data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle=window.adsbygoogle||[]).push({});</script> : <span>विज्ञापन | Google AdSense</span>}
</section>
